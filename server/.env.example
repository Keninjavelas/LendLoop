# --- Core ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/lendloop?replicaSet=rs0
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Reminder scheduler ---
# Set to false to keep the API running without the cron job (manual sends still work).
REMINDER_SCHEDULER_ENABLED=true
# node-cron expression. Default runs every minute; use "*/5 * * * *" to run every five.
REMINDER_CRON=* * * * *
# IANA timezone for the cron expression, e.g. Asia/Kolkata. Blank uses the server clock.
REMINDER_TIMEZONE=

# --- Mail delivery ---
# preview = render the message and log it without sending (no credentials needed).
# resend  = Resend over SMTP, requires RESEND_API_KEY.
# smtp    = any SMTP provider, requires SMTP_HOST.
MAIL_DRIVER=preview
MAIL_FROM=LendLoop <no-reply@lendloop.local>

# Used when MAIL_DRIVER is not "preview" and SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Used when MAIL_DRIVER=resend. Resend authenticates SMTP with the literal user "resend".
RESEND_API_KEY=
RESEND_HOST=smtp.resend.com
RESEND_PORT=587
RESEND_SECURE=false
